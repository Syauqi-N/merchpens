# ---------- Database ----------
# Local dev uses the Docker Postgres from docker-compose.yml (host port 5435)
DATABASE_URL="postgresql://merch:merchsecret@localhost:5435/merch?schema=public"

# ---------- Auth.js (NextAuth v5) ----------
# Generate a strong secret: openssl rand -base64 33
AUTH_SECRET="replace-with-strong-random-secret"
# Public base URL of the app (required by NextAuth v5)
AUTH_URL="http://localhost:3001"
APP_URL="http://localhost:3001"

# Google OAuth (Console: https://console.cloud.google.com/auth)
# Callback URL: http://localhost:3001/api/auth/callback/google
AUTH_GOOGLE_ID="your-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-client-secret"

# ---------- Duitku (POP flow) ----------
# Get sandbox credentials at https://passport.duitku.com/merchant
DUITKU_ENV="sandbox"                 # sandbox | production
DUITKU_MERCHANT_CODE="DXXXX"
DUITKU_API_KEY="your-sandbox-api-key"
# Duitku sends the server-to-server webhook here (must be PUBLICLY reachable;
# use a tunnel like ngrok/cloudflared for local testing)
DUITKU_CALLBACK_URL="http://localhost:3001/api/duitku/callback"
# Browser is redirected here after payment (display only)
DUITKU_RETURN_URL="http://localhost:3001/checkout/selesai"

# ---------- Cron (penyapu pesanan kedaluwarsa) ----------
# Generate: openssl rand -hex 32
# Wajib diisi di production — cron memanggil dengan header
# "Authorization: Bearer $CRON_SECRET". Tanpa ini endpoint menolak (401).
CRON_SECRET="replace-with-random-hex-32"

# ---------- E2E payment test ----------
# Base URL server yang sedang berjalan saat `npm run test:e2e`
E2E_BASE_URL="http://localhost:3001"
