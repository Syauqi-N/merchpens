# =============================================================================
#  CONTOH ENV PRODUKSI - Toko Alat Kedokteran Gigi
# =============================================================================
#  Cara pakai di VPS:
#    1) Salin berkas ini:      cp .env.production.example .env
#    2) Isi SEMUA nilai di bawah dengan data asli milik kamu.
#    3) Kunci izin berkasnya:  chmod 600 .env
#
#  NAMA BERKASNYA HARUS TEPAT ".env" — bukan ".env.production".
#  docker-compose.prod.yml membaca ".env" untuk dua hal sekaligus: mengirim
#  variabel ke dalam container (env_file) DAN mengisi ${VARIABEL} di dalam
#  berkas compose itu sendiri (POSTGRES_USER, TZ, dan sebagainya). Kalau
#  namanya lain, compose berhenti dengan pesan "POSTGRES_USER belum diisi".
#
#  PERINGATAN PENTING:
#  - JANGAN PERNAH commit berkas .env / .env.production yang berisi nilai ASLI
#    ke Git. Yang boleh masuk repo hanya berkas contoh ini (isinya placeholder).
#  - SEMUA nilai di bawah ini adalah PLACEHOLDER. Ganti dulu sebelum dipakai;
#    aplikasi tidak akan jalan benar kalau nilainya dibiarkan apa adanya.
#  - Kalau salah satu rahasia pernah bocor (terkirim chat, ter-commit, dsb),
#    ganti nilainya segera lalu deploy ulang.
#  - Sesudah mengubah berkas ini, container harus di-restart supaya nilai baru
#    terbaca (Next.js membaca env saat proses start).
# =============================================================================


# -----------------------------------------------------------------------------
# 1. IMAGE APLIKASI (dibangun GitHub Actions, disimpan di GHCR)
# -----------------------------------------------------------------------------
# Nama image tanpa tag. GitHub Actions bawaan memublikasikan ke format:
#   ghcr.io/<owner>/<nama-repository>
APP_IMAGE="ghcr.io/GANTI_OWNER/GANTI_NAMA_REPOSITORY"

# Gunakan tag immutable dari commit/release, bukan hanya "latest".
# Contoh hasil workflow: sha-a82cf91 atau v1.0.0.
APP_TAG="GANTI_TAG_IMAGE"


# -----------------------------------------------------------------------------
# 2. DATABASE (dipakai aplikasi Next.js)
# -----------------------------------------------------------------------------
# Perhatikan host-nya: "db" adalah NAMA LAYANAN Postgres di docker-compose,
# BUKAN localhost. Antar container, nama layanan otomatis jadi nama host.
# (localhost di dalam container app menunjuk ke container app itu sendiri,
# bukan ke database - ini penyebab error "connection refused" yang paling umum.)
#
# Port yang dipakai adalah port INTERNAL Postgres (5432), bukan port yang
# dipetakan ke host.
#
# Nilai user / password / nama database di bawah HARUS sama persis dengan
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB di bagian 8.
#
# Kalau password kamu mengandung karakter khusus (@ : / ? # & % +), password
# WAJIB di-URL-encode di sini. Cara paling aman: buat password tanpa karakter
# khusus sama sekali -> openssl rand -hex 24
DATABASE_URL="postgresql://merch:GANTI_PASSWORD_DATABASE@db:5432/merch?schema=public"


# -----------------------------------------------------------------------------
# 3. AUTH.JS (NextAuth v5) - sesi login admin & pelanggan
# -----------------------------------------------------------------------------
# Kunci penandatangan cookie sesi. WAJIB acak dan rahasia.
# Buat nilainya dengan perintah:
#     openssl rand -base64 33
# Kalau nilai ini diganti, semua orang yang sedang login akan ter-logout.
AUTH_SECRET="GANTI_DENGAN_HASIL_openssl_rand_base64_33"

# URL publik aplikasi untuk Auth.js. Harus sama dengan domain production.
# Tanpa ini, redirect setelah login/logout bisa ke domain yang salah.
# Contoh: https://stovitmart.my.id
AUTH_URL="https://domain-kamu.com"

# Wajib "true" saat aplikasi berada di belakang reverse proxy (Nginx/Caddy).
# Tanpa ini Auth.js menolak mempercayai header Host/X-Forwarded-* dari proxy,
# dan proses login akan gagal redirect.
AUTH_TRUST_HOST="true"

# URL publik aplikasi. Dipakai untuk menyusun tautan absolut (callback
# pembayaran, tautan pesanan, dsb). WAJIB https dan TANPA garis miring di akhir.
APP_URL="https://domain-kamu.com"

# Opsional: hanya isi kalau Auth.js perlu dipaksa memakai URL tertentu
# (mis. aplikasi dilayani dari sub-path). Umumnya cukup AUTH_TRUST_HOST di atas.
# AUTH_URL="https://domain-kamu.com"


# -----------------------------------------------------------------------------
# 4. DUITKU (pembayaran) - kredensial PRODUKSI
# -----------------------------------------------------------------------------
# Ambil kredensial produksi di dashboard merchant Duitku. Jangan memakai
# kredensial sandbox di sini: transaksi asli tidak akan pernah masuk.
DUITKU_ENV="production"

# Kode merchant produksi (contoh format: D1234).
DUITKU_MERCHANT_CODE="GANTI_KODE_MERCHANT"

# API key produksi. Ini rahasia paling sensitif di berkas ini: dipakai untuk
# tanda tangan HMAC-SHA256. Siapa pun yang memegangnya bisa memalsukan status
# "lunas". Jangan pernah ditulis di kode, tiket, atau chat.
DUITKU_API_KEY="GANTI_API_KEY_DUITKU"

# Alamat webhook server-to-server dari Duitku.
# WAJIB bisa diakses PUBLIK lewat HTTPS (bukan IP lokal, bukan http biasa).
# Alamat ini juga harus didaftarkan di dashboard merchant Duitku.
DUITKU_CALLBACK_URL="https://domain-kamu.com/api/duitku/callback"

# Alamat tujuan browser pembeli setelah selesai membayar (tampilan saja;
# status pembayaran yang dipercaya tetap berasal dari webhook di atas).
DUITKU_RETURN_URL="https://domain-kamu.com/checkout/selesai"


# -----------------------------------------------------------------------------
# 5. CRON - pelepas kuota pesanan kedaluwarsa
# -----------------------------------------------------------------------------
# Endpoint GET /api/cron/expire-orders wajib dipanggil berkala (mis. tiap 5-10
# menit). Tanpa itu, kuota pre-order pesanan yang tidak dibayar tidak pernah
# dilepas dan produk terlihat "habis" padahal tidak.
#
# Rahasia ini dikirim lewat HEADER, jangan pernah lewat query string
# (URL ikut tercatat di log akses server):
#     curl -fsS -H "Authorization: Bearer $CRON_SECRET" \
#       https://domain-kamu.com/api/cron/expire-orders
#
# Buat nilainya dengan:  openssl rand -hex 32
CRON_SECRET="GANTI_DENGAN_HASIL_openssl_rand_hex_32"


# -----------------------------------------------------------------------------
# 6. AKUN ADMIN AWAL (dibaca oleh: npm run db:admin)
# -----------------------------------------------------------------------------
# Dipakai sekali saat menyiapkan server untuk membuat akun admin pertama.
# Kalau akun dengan email ini sudah ada, passwordnya akan DIPERBARUI ke nilai
# di bawah - jadi variabel ini juga berguna untuk reset password admin.
#
# Aturan di lingkungan produksi (NODE_ENV=production):
#   - SEED_ADMIN_PASSWORD WAJIB diisi, minimal 8 karakter.
#   - Password demo "admin123" DITOLAK.
#   - Seed akan berhenti dengan pesan error kalau aturan di atas dilanggar.
#
# Saran: buat password kuat dengan  openssl rand -base64 18
#
# Perintah PERSIS untuk membuat/mereset akun admin di server (dijalankan dari
# folder proyek, setelah kedua baris di bawah diisi):
#
#     docker compose -f docker-compose.prod.yml run --rm tools
#
# Setelah akun jadi dan kamu sudah memastikan bisa login, HAPUS kembali baris
# SEED_ADMIN_PASSWORD dari berkas ini supaya passwordnya tidak tersimpan sebagai
# teks biasa di server:
#
#     sed -i '/^SEED_ADMIN_PASSWORD=/d' .env
#
# CATATAN: aplikasi ini TIDAK punya halaman "ganti kata sandi sendiri". Satu-satunya
# cara mengganti kata sandi siapa pun — termasuk kata sandi Pengurus Inti sendiri —
# adalah lewat tombol "Reset Password" di menu Pengguna panel admin (hanya bisa
# diakses peran Pengurus Inti/OWNER), atau dengan menjalankan lagi perintah di atas
# memakai email yang sama.
SEED_ADMIN_EMAIL="admin@domain-kamu.com"
SEED_ADMIN_PASSWORD="GANTI_PASSWORD_ADMIN_YANG_KUAT"


# -----------------------------------------------------------------------------
# 7. RUNTIME APLIKASI
# -----------------------------------------------------------------------------
# Menandai lingkungan produksi. Selain mengaktifkan mode produksi Next.js,
# nilai ini juga menyalakan pengaman seed di bagian 6.
NODE_ENV="production"

# Port yang didengarkan aplikasi di dalam container. Biarkan 3000 kecuali kamu
# mengubahnya juga di docker-compose dan konfigurasi reverse proxy.
PORT="3000"

# Zona waktu container. Memengaruhi tampilan tanggal pesanan dan periode PO.
# Dibaca juga oleh docker-compose.prod.yml untuk container db, cron, dan nginx.
TZ="Asia/Jakarta"


# -----------------------------------------------------------------------------
# 7b. PENYETELAN OPSIONAL (boleh dibiarkan seperti apa adanya)
# -----------------------------------------------------------------------------
# Semua variabel di bagian ini punya nilai bawaan yang masuk akal. Isi hanya
# kalau kamu memang perlu mengubahnya.

# Jeda antar panggilan penyapu pesanan kedaluwarsa oleh layanan "cron" di
# docker-compose.prod.yml, dalam MILIDETIK. Bawaan 300000 = 5 menit.
# Pesanan yang belum lunas dilepas kuotanya setelah 60 menit, jadi jeda 5-10
# menit sudah cukup rapat. Jangan diisi terlalu kecil (mis. 5000): endpoint
# akan dipanggil terus-menerus tanpa guna.
# CRON_INTERVAL_MS="300000"

# Berapa kali entrypoint mencoba menjalankan migrasi database sebelum menyerah,
# dan jeda antar percobaan dalam DETIK. Berguna kalau VPS-mu lambat dan
# PostgreSQL butuh waktu lebih lama untuk siap menerima koneksi.
# MIGRATE_MAX_ATTEMPTS="10"
# MIGRATE_RETRY_DELAY="3"

# CATATAN — variabel yang TIDAK perlu kamu isi di sini:
#   NEXT_TELEMETRY_DISABLED, HOSTNAME, HOME  -> sudah dipasang di dalam image.
#   CATALOG_CSV_PATH -> opsional; importer memakai /app/migrator/Daftar Harga.csv.
#   E2E_BASE_URL     -> hanya dipakai skrip uji di folder scripts/, dan folder
#                       itu memang tidak ikut masuk ke image produksi.


# -----------------------------------------------------------------------------
# 8. POSTGRES (dipakai layanan "db" di docker-compose, bukan oleh aplikasi)
# -----------------------------------------------------------------------------
# Nilai ini dipakai container Postgres untuk MEMBUAT database saat volume masih
# kosong (hanya pada inisialisasi pertama). Mengubah password di sini setelah
# database terbentuk TIDAK otomatis mengubah password di dalam database -
# ubahnya lewat: docker compose exec db psql -U toko -c "\password toko"
#
# Ketiga nilai ini harus konsisten dengan DATABASE_URL di bagian 2.
POSTGRES_USER="merch"
POSTGRES_PASSWORD="GANTI_PASSWORD_DATABASE"
POSTGRES_DB="merch"
